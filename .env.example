# Copy to .env and fill in. Never commit .env.
ELLE_USERNAME="ten-dang-nhap"
ELLE_EMAIL="your-alias@example.com"
ELLE_PASSWORD="ChangeMe123!"

# Browser options
HEADLESS="false"
SLOW_MO_MS="50"

# IMAP (script check_elle_mail.py) — Gmail cần App Password 16 ký tự
IMAP_USER="yourname@gmail.com"
IMAP_PASS="xxxx xxxx xxxx xxxx"
IMAP_FOLDER="INBOX"
IMAP_FROM="elledigital@3480726.brevosend.com"
IMAP_POLL_SEC="5"

# Batch register (script register_batch.py)
BATCH_WORKERS="5"
BATCH_SIZE="10"
BATCH_SLEEP_SEC="5"
BATCH_VERIFY_WAIT_SEC="120"
BATCH_LOG_LEVEL="normal"  # normal | quiet

# Verify (async batch click) — concurrency auto-tính từ BATCH_WORKERS (round(W*1.6), clamp 4-32).
# Chỉ set VERIFY_CONCURRENCY nếu muốn override thủ công.
# VERIFY_CONCURRENCY="8"
VERIFY_TIMEOUT_SEC="15"
# VERIFY_KEYWORDS="xác nhận,xac nhan,verify,confirm,kích hoạt,kich hoat,activate"
